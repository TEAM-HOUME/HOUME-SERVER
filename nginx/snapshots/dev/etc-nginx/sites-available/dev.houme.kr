server {
    listen 80;
    server_name dev.houme.kr;

    # certbot 갱신/발급용
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # HTTP -> HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name dev.houme.kr;
    add_header X-Served-By dev-proxy always;


    ssl_certificate     /etc/letsencrypt/live/dev.houme.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.houme.kr/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;   # ✅ 백엔드 포트 맞추기 (스프링/도커)
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # keep-alive / 업그레이드 대비
        proxy_set_header Connection "";
        proxy_redirect off;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}
